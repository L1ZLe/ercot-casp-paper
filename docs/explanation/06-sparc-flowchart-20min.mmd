  subgraph G_D1["D1 - Market, shadow price, spread"]
    M["ERCOT day-ahead, nodal"] --> P1["Nodal price<br/>LMPᵢ = λ + Σₖ SFₖ,ᵢ · μₖ"]
    P1 --> P2["Energy component λ<br/>same at every node"]
    P1 --> P3["Congestion component<br/>Σ SF · μ, location-specific"]
    P3 --> SP["Shadow price μₖ<br/>μₖ = marginal cost of relaxing<br/>constraint k by 1 MW"]
    SP --> EX_D1["Example: road at capacity<br/>one more MW costs +$20<br/>therefore μ = $20/MWh"]
    SP --> TOPK["Selection: per hour, per constraint<br/>sort by its own μ descending, take top 50<br/>binding only, snapshot lagged one hour"]
    P1 --> SPREAD["Path spread<br/>ΔLMPₛ→d = LMP_d − LMP_s<br/>= Σₖ (SFₖ,d − SFₖ,s) · μₖ<br/>= Σₖ ΔSFₖ · μₖ"]
    SPREAD --> C1["λ cancels exactly<br/>spread = pure congestion differential"]
    SPREAD --> DSF_D1["Differential shift factor<br/>ΔSFₖ = SFₖ,d − SFₖ,s<br/>Example: 0.6 − 0.1 = 0.5<br/>If μₖ = $20/MWh, contribution = $10/MWh"]
    DSF_D1 --> Z["If ΔSFₖ = 0, the constraint affects both ends equally<br/>Contribution to the spread = 0"]
    SP --> ARG["WHY THIS IS THE RIGHT ASSUMPTION<br/>μ is the market's own signal of<br/>where and how badly the grid is constrained"]
    ARG --> DOM["Needs domain understanding,<br/>not just sending prices to ML. And that is shown by our results"]
    ARG --> LINK["Outcome link (canonical raw, 5-seed)<br/>price-only models: good center, bad risk<br/>LQR coverage 71.1%, crosses 32.5%<br/>SPARC 88.8%, crosses 3.0%"]
  end

  subgraph G_D2["D2 - SCED, the anchor, our move"]
    SCED["SCED optimization<br/>solved every hour"] --> OUT["Outputs simultaneously<br/>LMPs, binding constraints, shadow prices"]
    OUT --> IDENTITY["LMP identity is EXACT at the optimum<br/>LMP_i = λ + Σₖ SFₖ,ᵢ · μₖ<br/>λ, SF, μ are the primal and dual<br/>quantities of the optimization"]
    IDENTITY --> ENDOG["But they are ENDOGENOUS<br/>defined only by solving the clearing<br/>no closed-form function from raw inputs"]
    ENDOG --> MUST["Rule is real, but NOT transcribable<br/>so LEARN the exposure weights"]
    OUT --> DSF_D2["ΔSF is not published for each<br/>source-destination pair<br/>depends on topology + operating point"]
    DSF_D2 --> MUST

    ANCHOR["Anchor: Yu et al., Austria<br/>MRINN"] --> RULE["Known piecewise settlement formula<br/>embedded as differentiable layers<br/>= RULE-EMBEDDING"]
    RULE --> HARD["Hard hierarchical head<br/>non-crossing by construction, AQCR = 0"]
    RULE --> GAPS["Never reports coverage, Winkler, CRPS, PIT"]

    MUST --> MOVE["Our move: condition on the PAST published clearing outputs<br/>most recent snapshot strictly before the target hour<br/>the target hour's own μ is NOT used —<br/>it exists only after that hour clears, so using it would leak"]
    MOVE --> LEARN["What is given: the lagged μ (a published output)<br/>What is learned: ΔSF, as attention weights"]
    MOVE --> NOT["SPARC is constraint-aware<br/>NOT market-rule-informed"]
  end

  subgraph G_D3["D3 - The model"]
    IN["Inputs<br/>top-50 constraint slots (μ, identity, kV, flow)<br/>temporal Fourier, 3 lagged spreads, path embedding"] --> ID
    IN --> MU
    ID["Identity pathway<br/>MEAN-POOLED over binding constraints<br/>fixed size because K varies hourly<br/>captures WHICH set of corridors binds"] --> ATTN_D3
    MU["Shadow-price pathway<br/>per-slot keys and values<br/>the VALUES carry the shadow-price (μ) signal"] --> ATTN_D3
    TEMP["Temporal encoder"] --> ATTN_D3
    Q["Query = the path asking<br/>which constraints matter for me"] --> ATTN_D3
    ATTN_D3["Constraint attention<br/>aₖ = exp(scoreₖ) / Σⱼ exp(scoreⱼ)<br/>Σₖ aₖ = 1<br/>aₖ = learned relative exposure weight<br/>(plays the role of ΔSF: positive + normalized,<br/>so it captures relative magnitude)"] --> HEAD
    ATTN_D3 --> BLEND["Weighted blend of the value signals<br/>≈ Σₖ aₖ · μₖ<br/>same form as Σₖ ΔSFₖ · μₖ"]
    HEAD["Quantile head<br/>soft flat head + crossing penalty<br/>raw AQCR 2.98% vs LQR 32.5%, MLP 13.6%<br/>(hard head is 0.00% by construction)"] --> LOSS["Training loss<br/>ℒ = Σₜ Στ ρτ(yₜ − q̂τ,t) + λ · crossing penalty<br/>ρτ(u) = u · (τ − I[u &lt; 0])<br/>penalty is training-only, never a metric"]
    HEAD --> HARD2["Hard (hierarchical) head tested on SPARC<br/>calibrated Winkler 18.72 vs soft 17.70 → kept soft"]
    LAG["Lagged-spread encoder"] --> HEAD

    ATTN_D3 --> WHY_ROOT["Why attention, not something else?"]
    WHY_ROOT --> A1["Raw concatenation of the constraints<br/>REJECTED<br/>the number of binding constraints changes every hour<br/>the network needs a fixed-size input"]
    WHY_ROOT --> A2["Mean-pool everything<br/>REJECTED<br/>treats every binding line as equally important for every path<br/>destroys selectivity: a line near the sink should matter more than one far away"]
    WHY_ROOT --> A3["MLP over the constraint features<br/>REJECTED<br/>no explicit weight per constraint<br/>cannot tell you which line drove the forecast"]
    WHY_ROOT --> A4["RNN or Transformer over the constraint set<br/>REJECTED<br/>a set has no order; first and last are interchangeable<br/>imposes an order that does not exist"]
    WHY_ROOT --> WIN["ATTENTION — CHOSEN<br/>handles a variable-size set<br/>gives a per-path weight to each constraint<br/>order-free (permutation-invariant)<br/>the weights play the role of learned ΔSF<br/>→ interpretable by construction"]
  end

  subgraph G_D4["D4 - Metrics"]
    EX_D4["Running example<br/>Observed value: y = 10<br/>90% interval: [L, U] = [−5, 15]<br/>Median forecast: q₀.₅ = 8"] --> AQL
    EX_D4 --> COV
    EX_D4 --> WINK
    EX_D4 --> AQCR
    AQL["AQL / pinball loss<br/>ρτ(y − qτ) = (y − qτ) · (τ − I[y &lt; qτ])<br/>At τ = 0.5: error 2 → loss 1.0<br/>At τ = 0.9: error 2 → loss 1.8"]
    COV["Empirical interval coverage<br/>Coverage = (1/N) · Σₜ I[Lₜ ≤ yₜ ≤ Uₜ]<br/>For a 90% interval: Lₜ = q₀.₁ and Uₜ = q₀.₉<br/>88 of 100 hours inside = 88%"]
    WINK["Winkler score for a 90% interval<br/>W = U − L, if L ≤ y ≤ U<br/>W = U − L + 20(L − y), if y &lt; L<br/>W = U − L + 20(y − U), if y &gt; U"]
    AQCR["Adjacent quantile crossing rate<br/>AQCR = crossings / adjacent quantile pairs<br/>A crossing occurs when qτⱼ &gt; qτⱼ₊₁<br/>SPARC 2.98% vs LQR 32.54%"]
    AQL --> PARADOX["THE METRIC-PARADOX<br/>AQL is middle-dominated → LQR wins it<br/>Winkler taxes the band edges → SPARC wins it<br/>the reported winner depends on the metric"]
    COV --> TRADE["Why it matters for trading<br/>a band claiming 90% but holding 71%<br/>leaves 29% of hours under-hedged<br/>low mean error does NOT rescue bad intervals"]
    PARADOX --> TRADE
  end

  subgraph G_D5["D5 - Results and mechanism (canonical 5-seed)"]
    PROTO["Protocol<br/>CPU, chronological 70-15-15<br/>5 seeds 42-46, pure-pinball AQL<br/>ablation = remove one part, retrain, measure the drop"] --> RESULTS
    RESULTS["Raw results, primary pair<br/>SPARC coverage 88.82, Winkler 18.43, AQL 1.209, AQCR 2.98<br/>LQR 71.09, 24.64, 1.171, 32.54<br/>MLP 82.98, 23.07, 1.420<br/>LSTM 78.61, Transformer 79.80, XGB 79.23, RF 34.97"] --> WINS["Findings<br/>best calibrated; AQL parity with LQR (p=0.077, n.s.)<br/>beats every deep net on AQL/MAE<br/>coverage significant vs LQR: t=7.79, p=0.0015<br/>8,978 params = 7-9x smaller"]
    RESULTS --> CAL["Calibrated (flat split-conformal)<br/>SPARC cov 90.81, width 13.40, Winkler 17.70 (best)<br/>LQR cov 91.68, width 12.69, Winkler 20.01<br/>MLP cov 94.14, width 17.05, Winkler 19.86<br/>= coverage equalized; SPARC wins width-efficiency"]
    RESULTS --> HONEST["Honest negatives<br/>LQR wins raw AQL (1.171 vs 1.209, n.s.)<br/>CRPS parity; one ablation (no path embed, AQL 1.180) edges us<br/>scope: central 90% band, extreme events out of scope"]
    PROTO --> ABL["Ablations (raw coverage; calibrated Winkler)<br/>No attention: 88.82 → 76.35, AQL flat 1.209 → 1.217<br/>= attention is the load-bearing calibration mechanism<br/>No identity −7.31pp vs no-μ −0.51pp = WHICH binds beats HOW large<br/>No temporal: AQL 1.640 = temporal drives point error<br/>No lags ≈ full (89.45) = lagged history redundant"]
    ABL --> ATTN_D5["Mechanism<br/>attention 0.19-0.26 (mean 0.23) on top-3 μ slots<br/>about 12x the uniform 0.020; peaks 0.257 at max μ 84.8"]
  end

  subgraph G_D6["D6 - Generalization, God model, limits"]
    PAIRS["3 pairs = 1 primary + 2 probes<br/>primary HB_HUBAVG to HB_PAN: full comparison, 5 seeds<br/>probes NORTH 86.57%, WEST 90.98%: proposed model only<br/>claim = calibration consistency, not a ranked comparison"]
    PAIRS --> SEAS["Near-range OOD (canonical monthly Jan-May 2026, 2-seed)<br/>SPARC coverage 90.2% vs LQR 89.7%; SPARC also wins AQL<br/>electricity is strongly seasonal; which corridors bind changes with the season<br/>so season-to-season is the decision-relevant test<br/>NOTE: the 3-window 87.8/92.7/62.5 numbers are NOT in the canonical build"]
    PAIRS --> XY["Cross-year full 2025→2026 (2-seed): stress limit, not the operating regime<br/>SPARC coverage 72.2% vs LQR 59.6%; LQR wins AQL (1.065 vs 1.183)<br/>8,978 params → retrain frequently<br/>train-once-generalize-a-year is the wrong question"]
    PAIRS --> CONF["Conformal defense — the result<br/>wrap LQR in flat split-conformal → coverage 91.7%, width 12.69<br/>but calibrated Winkler 20.01, still worse than SPARC 17.70<br/>→ conformal equalizes coverage but not width-efficiency<br/>→ the edge is INTRINSIC to the architecture"]
    PAIRS --> SENS["Sensitivity (2-seed)<br/>lag sets 24 / 24-48 / 24-48-168<br/>lead 1, 2, 4, 12 hours → coverage stable 89.5%"]
    PAIRS --> GOD["God model: fuse every model's winning axis<br/>10 directions tested (godmode conformal; SPARC baseline 17.52)<br/>A 22.35, B 18.36, C 18.37, full 18.86, D 18.19, E 86.4%/14.59,<br/>MV p=0.030, β width 34.14, γ coverage 64.66%, λ 17.772 vs 17.702<br/>NONE beats SPARC at 5 seeds → SPARC is at the optimum"]
    GOD --> LIM["Honest limits<br/>no method is PIT-uniform<br/>AQL and CRPS are parity, not superiority<br/>cross-year error edge does not hold<br/>seasonal 3-window claim not in canonical build<br/>one market, one year, one headline pair"]
  end
